def Names_of_medicines(url,headers,relget2):
    get=requests.get(headers=headers , url= url)
    get2=BeautifulSoup(get.text, "html.parser")
    get3=get2.find_all("ul", class_="ddc-list-column-2")
    for get4 in get3:
        get5=get4.get_text(strip=True)
        relget2.extend(get5.split('\n'))
    with open("Names_of_medicines", "w", encoding="utf-8") as file:
        json.dump(relget2, file, ensure_ascii=False, indent=4)
    return relget2

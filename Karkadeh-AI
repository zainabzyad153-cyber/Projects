def search_engine(query,num_results=10, start=1):
    all_results = []
    for one_a_question in [q for q in query if q.strip() != '']:
        Answer = json.dumps(
            {
                "q": one_a_question,
                "hl": 'en',
                "num": 10
            }
        )
        headers = {
            'X-API-KEY': "api",
            'Content-Type': 'application/json'
        }
        post_Question=requests.post('https://google.serper.dev/search',
            headers=headers , data= Answer)
        result = post_Question.json()
        all_results.append(result)
    with open("Drug information", "a", encoding="utf-8") as file:
        json.dump(all_results, file, ensure_ascii=False, indent=4)   
    return all_results 
all_results=search_engine(query,num_results=10, start=1) 
